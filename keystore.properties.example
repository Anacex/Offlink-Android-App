# Copy to keystore.properties and fill in. Keep keystore.properties out of git.
# For a new keystore with correct ISO country (e.g. PK), generate a NEW .jks — you cannot change DN on an existing file.
# Paths are relative to this folder (Offlink-Android-App/), same level as app/.
storeFile=offlink-release.jks
storePassword=CHANGE_ME
keyAlias=offlink
keyPassword=CHANGE_ME
